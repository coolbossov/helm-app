# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zoho Bigin
ZOHO_BIGIN_CLIENT_ID=
ZOHO_BIGIN_CLIENT_SECRET=
ZOHO_BIGIN_REFRESH_TOKEN=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Write-freeze guard — set to "true" during DB migrations to return 503 on all
# mutating requests (POST/PUT/PATCH/DELETE). GET/HEAD/OPTIONS continue to flow.
# /api/sync/cron is exempt so scheduled sync jobs keep running during a freeze.
# Leave unset in normal operation.
READ_ONLY=
